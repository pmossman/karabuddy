# Neon Postgres — `vercel env pull` populates these with the PROD values.
# For local dev, DON'T edit them here; instead run against a local Docker
# Postgres via .env.development.local (see docs/local-dev-db.md). This file
# stays as-is and serves as the prod snapshot SOURCE for db:pull-snapshot.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Replay payload store (ADR 0011). Default driver = Vercel Blob:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Cloudflare R2 instead (free tier: 10 GB, 1M writes/mo, no egress). Create a
# bucket, enable public access (r2.dev subdomain or a custom domain), add a CORS
# rule allowing GET from https://karabuddy.app, and an API token scoped to it.
# Rows on both stores coexist; scripts/migrate-payloads.ts moves the old ones.
# KARABUDDY_BLOB_DRIVER=s3
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=karabuddy-replays
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Replay payload retention (ADR 0011). The daily cron /api/cron/prune-payloads
# (vercel.json) deletes the blob of replays nobody opened within the window.
# CRON_SECRET=            # openssl rand -hex 32 — Vercel sends it as Bearer auth
# REPLAY_PAYLOAD_RETENTION_DAYS=30
# NEXT_PUBLIC_REPLAY_RETENTION_DAYS=30   # what the viewer's "expired" notice says

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (Discord can be reused from your swutrade app — just add
# karabuddy's callback URL https://karabuddy.vercel.app/api/auth/callback/discord
# and http://localhost:3000/api/auth/callback/discord to the Discord app's
# redirect URIs)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Extension kill-switch policy (optional; prod-only tuning) ---
# Drives GET /api/extension/status (lib/extensionPolicy.ts). All optional —
# sensible defaults exist. Keep KARABUDDY_EXT_LATEST tracking the CWS-published
# version so older installs get the "update available" nag.
# KARABUDDY_EXT_LATEST=0.5.2
# KARABUDDY_EXT_MIN_SUPPORTED=0.0.0     # raise only to break-glass a dangerous version (block tier)
# KARABUDDY_EXT_NAG_MESSAGE=
# KARABUDDY_EXT_BLOCK_MESSAGE=

# --- Discord integration (B81; optional — features no-op until set) ---
# Bot token for DMs (mention notifications) + team-server posting. From the
# Discord developer portal (reuse the same app as the OAuth sign-in above).
# DISCORD_BOT_TOKEN=
# Public base URL used in DM deep-links (defaults to https://karabuddy.app).
# KARABUDDY_PUBLIC_URL=https://karabuddy.app
# Channel webhook URLs in the KaraBuddy Discord server for ops pings.
# DISCORD_CI_WEBHOOK_URL=        # deploy.yml posts CI/deploy results here
# DISCORD_ALERTS_WEBHOOK_URL=    # B80 drift endpoint posts breakage pings here

# --- SWU Forge team migration (optional; ships DARK until BOTH are set) ---
# "Move this team to SWU Forge" in team settings. The owner-only card, the
# /teams/<slug>/move preview and POST /api/teams/<slug>/forge-migration are all
# invisible (404) until both of these are present — the shared secret IS the
# flag, so there is no second switch to forget. The secret must MATCH the value
# set on the Forge deploy; it is server-only and never reaches a browser.
# SWU_FORGE_ORIGIN=https://swuforge.com
# TEAM_MIGRATION_SECRET=         # openssl rand -hex 32 — identical on both deploys
#
# ⚠ Forge also pins the CALLER'S origin (TEAM_MIGRATION_ALLOWED_ORIGINS over
# there, comma-separated because this app has two Vercel projects) and refuses
# any request that arrives without an `Origin` header — Node's fetch sends none
# server-to-server, so KaraBuddy states its own. It states AUTH_URL's origin,
# which is already set everywhere; that exact value must appear in Forge's list.
# Set KARABUDDY_ORIGIN only for a deploy that is reached at a different origin
# than Auth.js is configured with.
# KARABUDDY_ORIGIN=https://karabuddy.app

# --- Prod snapshot source (optional; db:pull-snapshot) ---
# scripts/pull-prod-snapshot.sh reads prod from POSTGRES_URL_NON_POOLING above
# by default; set this to override the source explicitly.
# SNAPSHOT_SOURCE_URL=

# --- NOT set here ---
# Local dev DB overrides (KARABUDDY_DB_DRIVER=pg + a localhost:5434 POSTGRES_URL)
#   live in .env.development.local — see docs/local-dev-db.md.
# Test-only vars (KARABUDDY_DB_DRIVER=pglite, KARABUDDY_BLOB_MODE=memory,
#   KARABUDDY_TEST_API, AUTH_URL, KARABUDDY_PGLITE_PATH) are set by the
#   test:* scripts in package.json, not here.
