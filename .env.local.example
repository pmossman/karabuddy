# Neon Postgres (set up at https://console.neon.tech)
# B74: point local dev at a SEPARATE database, NOT prod. Easiest is a Neon
# branch off prod ("Branches" tab → Create branch → use ITS connection
# string here). Then `npm run db:migrate` + `npm run db:pull-snapshot` to
# load realistic data. See docs/extension-rollout.md for the click-path.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# B74: prod→local snapshot refresh (`npm run db:pull-snapshot`). SOURCE is
# prod (dumped read-only); TARGET is your local DB above (DROPPED + restored).
# Both required + must differ; the script refuses if they match.
SNAPSHOT_SOURCE_URL=postgres://...prod...
SNAPSHOT_TARGET_URL=postgres://...local-branch...

# Vercel Blob (set up via `vercel link` + Storage tab, or `vercel blob` CLI)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (Discord can be reused from your swutrade app — just add
# karabuddy's callback URL https://karabuddy.vercel.app/api/auth/callback/discord
# and http://localhost:3000/api/auth/callback/discord to the Discord app's
# redirect URIs)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
