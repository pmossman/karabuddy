# Neon Postgres — `vercel env pull` populates these with the PROD values.
# For local dev, DON'T edit them here; instead run against a local Docker
# Postgres via .env.development.local (see docs/local-dev-db.md). This file
# stays as-is and serves as the prod snapshot SOURCE for db:pull-snapshot.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Vercel Blob (set up via `vercel link` + Storage tab, or `vercel blob` CLI)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (Discord can be reused from your swutrade app — just add
# karabuddy's callback URL https://karabuddy.vercel.app/api/auth/callback/discord
# and http://localhost:3000/api/auth/callback/discord to the Discord app's
# redirect URIs)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Extension kill-switch policy (optional; prod-only tuning) ---
# Drives GET /api/extension/status (lib/extensionPolicy.ts). All optional —
# sensible defaults exist. Keep KARABUDDY_EXT_LATEST tracking the CWS-published
# version so older installs get the "update available" nag.
# KARABUDDY_EXT_LATEST=0.5.2
# KARABUDDY_EXT_MIN_SUPPORTED=0.0.0     # raise only to break-glass a dangerous version (block tier)
# KARABUDDY_EXT_NAG_MESSAGE=
# KARABUDDY_EXT_BLOCK_MESSAGE=

# --- Discord integration (B81; optional — features no-op until set) ---
# Bot token for DMs (mention notifications) + team-server posting. From the
# Discord developer portal (reuse the same app as the OAuth sign-in above).
# DISCORD_BOT_TOKEN=
# Public base URL used in DM deep-links (defaults to https://karabuddy.app).
# KARABUDDY_PUBLIC_URL=https://karabuddy.app
# Channel webhook URLs in the KaraBuddy Discord server for ops pings.
# DISCORD_CI_WEBHOOK_URL=        # deploy.yml posts CI/deploy results here
# DISCORD_ALERTS_WEBHOOK_URL=    # B80 drift endpoint posts breakage pings here

# --- Prod snapshot source (optional; db:pull-snapshot) ---
# scripts/pull-prod-snapshot.sh reads prod from POSTGRES_URL_NON_POOLING above
# by default; set this to override the source explicitly.
# SNAPSHOT_SOURCE_URL=

# --- NOT set here ---
# Local dev DB overrides (KARABUDDY_DB_DRIVER=pg + a localhost:5434 POSTGRES_URL)
#   live in .env.development.local — see docs/local-dev-db.md.
# Test-only vars (KARABUDDY_DB_DRIVER=pglite, KARABUDDY_BLOB_MODE=memory,
#   KARABUDDY_TEST_API, AUTH_URL, KARABUDDY_PGLITE_PATH) are set by the
#   test:* scripts in package.json, not here.
