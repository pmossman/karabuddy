# Neon Postgres — `vercel env pull` populates these with the PROD values.
# For local dev, DON'T edit them here; instead run against a local Docker
# Postgres via .env.development.local (see docs/local-dev-db.md). This file
# stays as-is and serves as the prod snapshot SOURCE for db:pull-snapshot.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Vercel Blob (set up via `vercel link` + Storage tab, or `vercel blob` CLI)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (Discord can be reused from your swutrade app — just add
# karabuddy's callback URL https://karabuddy.vercel.app/api/auth/callback/discord
# and http://localhost:3000/api/auth/callback/discord to the Discord app's
# redirect URIs)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
