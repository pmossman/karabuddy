{
    "manifest_version": 3,
    "name": "KaraBuddy",
    "version": "0.4.0",
    "version_name": "0.4.0",
    "description": "Records your karabast.net matches automatically and lets you tag key moments. Watch replays on karabuddy.app.",
    "icons": {
        "128": "icons/128.png"
    },
    "permissions": ["storage", "tabs"],
    "host_permissions": [
        "https://karabast.net/*",
        "https://karabuddy.app/*",
        "https://*.karabuddy.app/*",
        "https://*.vercel.app/*",
        "http://localhost:3000/*"
    ],
    "action": {
        "default_title": "KaraBuddy",
        "default_icon": {
            "16": "icons/16.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://karabast.net/*"],
            "js": [
                "replays/01-namespace.js",
                "replays/02-decoder.js",
                "replays/03-recorder.js",
                "replays/05-footer.js",
                "replays/07-toast.js",
                "replays/06-bootstrap.js"
            ],
            "run_at": "document_start",
            "all_frames": false,
            "world": "MAIN"
        },
        {
            "matches": ["https://karabast.net/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "https://karabuddy.app/*",
                "https://*.karabuddy.app/*",
                "https://*.vercel.app/*",
                "http://localhost:3000/*"
            ],
            "js": ["karabuddy-bridge.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}
